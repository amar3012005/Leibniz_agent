# ============================================================================
# Leibniz Agent - Environment Variables Template
# ============================================================================
# Copy this file to .env (in the same folder) and fill in your values.
# Do NOT commit real secrets to version control.

# ============================================================================
# CORE API KEYS
# ============================================================================

# Gemini API Key (Required for STT and LLM - NOT for TTS)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LemonFox TTS API Key (Required for Primary TTS Provider)
# Get from: https://www.lemonfox.ai/apis/keys
LEMONFOX_API_KEY=your_lemonfox_api_key_here

# ElevenLabs API Key (Optional - Fallback TTS Provider)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Sarah voice (soft, female)

# Google Cloud Credentials (Optional - Fallback TTS Provider)
# Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-credentials.json

# ============================================================================
# TTS CONFIGURATION
# ============================================================================

# TTS Provider Selection
LEIBNIZ_TTS_PROVIDER=lemonfox  # Options: lemonfox, google, elevenlabs, auto
LEIBNIZ_TTS_FALLBACK_PROVIDER=google  # Fallback provider if primary fails
LEIBNIZ_TTS_ENABLE_FALLBACK=true  # Enable automatic fallback

# LemonFox TTS Settings (Optional - defaults provided)
LEIBNIZ_LEMONFOX_VOICE=sarah  # Options: sarah, heart, bella, michael, alloy, nova, echo, onyx
LEIBNIZ_LEMONFOX_LANGUAGE=en-us  # Options: en-us, de-de, es-es, fr-fr, it-it, pl-pl, pt-br, nl-nl

# ElevenLabs Voice Settings (Optional)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Rachel voice
ELEVENLABS_MODEL=eleven_multilingual_v2
LEIBNIZ_ELEVENLABS_STABILITY=0.5  # 0.0-1.0
LEIBNIZ_ELEVENLABS_SIMILARITY_BOOST=0.75  # 0.0-1.0

# Google TTS Settings (Optional)
GOOGLE_TTS_VOICE=en-US-Neural2-F  # Female neural voice

# ============================================================================
# AUDIO SETTINGS
# ============================================================================

LEIBNIZ_TTS_SAMPLE_RATE=24000  # Audio sample rate (Hz)
LEIBNIZ_TTS_SPEAKING_RATE=1.0  # 0.25 to 4.0 (1.0 = normal)
LEIBNIZ_TTS_PITCH=0.0  # -20.0 to 20.0 (semitones)
LEIBNIZ_TTS_VOLUME_GAIN_DB=0.0  # Volume adjustment (dB)
LEIBNIZ_TTS_LANGUAGE_CODE=en-US  # Language for TTS

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

LEIBNIZ_TTS_ENABLE_CACHE=true  # Enable audio caching
LEIBNIZ_TTS_MAX_CACHE_SIZE=500  # Maximum cached entries
LEIBNIZ_TTS_CACHE_TTL_DAYS=30  # Cache expiration (days)
LEIBNIZ_TTS_CACHE_DIR=/app/audio_cache  # Cache directory path

# ============================================================================
# SERVICE SETTINGS
# ============================================================================

LEIBNIZ_TTS_TIMEOUT=30.0  # Synthesis timeout (seconds)
LEIBNIZ_TTS_RETRY_ATTEMPTS=3  # Retry attempts on failure
LEIBNIZ_TTS_RETRY_DELAY=1.0  # Delay between retries (seconds)

# Mock TTS for testing (no real API calls)
MOCK_TTS=false  # Set to true for development/testing

# ============================================================================
# BACKGROUND AUDIO (Optional)
# ============================================================================

LEIBNIZ_ENABLE_BACKGROUND_AUDIO=true  # Enable background music
LEIBNIZ_BACKGROUND_AUDIO_PATH=leibniz_agent/audio/background.wav
LEIBNIZ_BACKGROUND_AUDIO_VOLUME=0.3  # 0.0 to 1.0

# ============================================================================
# MONGODB (Optional - for conversation history)
# ============================================================================

MONGODB_URI=mongodb://localhost:27017/leibniz  # MongoDB connection string

# ============================================================================
# NOTES
# ============================================================================
# 
# LemonFox.ai:
#   - Pricing: $2.50 per 1,000,000 characters (~90% cheaper than ElevenLabs)
#   - Quality: High-quality natural voices
#   - Languages: 8+ languages with multilingual voices
#   - Latency: Medium (complete file synthesis, ~1-3s)
#   - Get API key: https://www.lemonfox.ai/signup
#
# Google Cloud TTS:
#   - Pricing: Free tier (1M characters/month), then $4/1M characters
#   - Quality: High-quality neural voices
#   - Languages: 50+ languages
#   - Latency: Low (~1-2s)
#   - Setup: Requires service account JSON file
#
# ElevenLabs:
#   - Pricing: $5/month starter, pay-per-character
#   - Quality: Premium quality, emotion-aware
#   - Languages: 29+ languages
#   - Latency: Medium (~2-4s)
#   - Note: Uses API quota, requires active subscription
#
