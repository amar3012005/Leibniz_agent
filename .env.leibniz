# Leibniz University Agent - Environment Variables Template
# ========================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit .env to version control!
#
# Note: This system uses Gemini Live API for STT instead of OpenAI Whisper
# for better integration with the existing Gemini infrastructure.

# ============================================================================
# Gemini Configuration (STT via Live API + LLM for intent parsing, RAG generation)
# ============================================================================
# Used for both STT (Gemini Live API), intent classification, and LLM operations
# Comment 6: SECURITY WARNING - Replace with your own API key!
# 1. Copy this file to .env (NOT tracked in git)
# 2. Replace YOUR_GEMINI_API_KEY_HERE with your actual key
# 3. Verify .gitignore excludes .env* to prevent accidental commits
# 4. Get your key: https://makersuite.google.com/app/apikey
# 5. If this placeholder was replaced with a real key and committed, ROTATE IT IMMEDIATELY
GEMINI_API_KEY=AIzaSyCjmsOeeI3Y4-0WLXH0Z8fXst6JQY5erJ0
# CRITICAL FIX: Must use gemini-2.0-flash-exp for Live API (NOT models/gemini-2.0-flash-live-exp)
# Live API v1beta requires model name WITHOUT "models/" prefix
# See: https://ai.google.dev/gemini-api/docs/live-api
GEMINI_MODEL=gemini-flash-lite-latest
# Model for STT operations (same as above for Live API)
GEMINI_STT_MODEL=gemini-live-2.5-flash-preview
# English language code for STT
GEMINI_STT_LANGUAGE=en-US

# Get Gemini API key: https://makersuite.google.com/app/apikey

# ============================================================================
# Intent Parser Configuration
# ============================================================================
# The intent parser uses Gemini for complex classification and fast patterns for common queries

# Confidence threshold for fast pattern matching (0.0-1.0)
LEIBNIZ_INTENT_PARSER_CONFIDENCE_THRESHOLD=0.8

# Enable context extraction (user_goal, key_entities, extracted_meaning)
LEIBNIZ_INTENT_PARSER_ENABLE_CONTEXT_EXTRACTION=true

# Log all classifications for debugging and monitoring
LEIBNIZ_INTENT_PARSER_LOG_CLASSIFICATIONS=true

# Target percentage for fast route (0.8 = 80% of queries should use fast patterns)
LEIBNIZ_INTENT_PARSER_FAST_ROUTE_TARGET=0.8

# Timeout for Gemini classification in seconds
LEIBNIZ_INTENT_PARSER_GEMINI_TIMEOUT=5.0

# Minimal output mode - strip non-essential fields (only intent, confidence, context)
LEIBNIZ_INTENT_PARSER_MINIMAL_OUTPUT=false

# Intent Parser Setup:
#   1. Ensure GEMINI_API_KEY is set (required for complex classification)
#   2. Adjust confidence threshold based on your accuracy requirements
#   3. Enable context extraction for better RAG retrieval (recommended)
#   4. Monitor fast_route_percentage to optimize pattern matching
# Recommendation: Keep confidence threshold at 0.8 for balanced accuracy and performance

# ============================================================================
# RAG (Retrieval-Augmented Generation) Configuration
# ============================================================================
# Context-aware knowledge retrieval using FAISS + sentence-transformers + Gemini

# Knowledge base path (63 documents across 12 categories)
# IMPORTANT: Use absolute path for reliability (relative paths resolve from cwd, causing issues when running from leibniz_agent/ directory)
# Actual location: C:/Users/AMAR/SINDHv2/SINDH-Orchestra-Complete/leibniz_knowledge_base (repository root)
LEIBNIZ_RAG_KNOWLEDGE_BASE_PATH=C:/Users/AMAR/SINDHv2/SINDH-Orchestra-Complete/leibniz_knowledge_base
# Vector store path for FAISS index
LEIBNIZ_RAG_VECTOR_STORE_PATH=leibniz_agent/vector_store

# Embedding model for semantic search (sentence-transformers)
LEIBNIZ_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Top-K candidates to retrieve from FAISS (before entity filtering)
LEIBNIZ_RAG_TOP_K=20
# Top-N documents to use after entity filtering
LEIBNIZ_RAG_TOP_N=5
# Minimum similarity threshold (0.0-1.0, lower = more permissive)
LEIBNIZ_RAG_SIMILARITY_THRESHOLD=0.6

# Chunking configuration
# Chunk size range: 500-800 characters (Leibniz-optimized)
LEIBNIZ_RAG_CHUNK_SIZE_MIN=500
LEIBNIZ_RAG_CHUNK_SIZE_MAX=800
# Overlap between chunks to prevent information loss
LEIBNIZ_RAG_CHUNK_OVERLAP=100

# Response generation settings
# Response style: friendly_casual (not formal academic)
LEIBNIZ_RAG_RESPONSE_STYLE=friendly_casual
# Maximum response length in characters
LEIBNIZ_RAG_MAX_RESPONSE_LENGTH=500
# Enable response humanization (conversational starters, helpful endings)
LEIBNIZ_RAG_ENABLE_HUMANIZATION=true
# Minimum quality score for responses (0.0-1.0, triggers retry if below)
LEIBNIZ_RAG_MIN_QUALITY_SCORE=0.5

# Performance settings
# Enable vector store pre-warming during TTS playback
LEIBNIZ_RAG_ENABLE_PREWARM=true
# Auto-build vector store on first query if not found
LEIBNIZ_RAG_AUTO_BUILD=true
# RAG query timeout in seconds
LEIBNIZ_RAG_TIMEOUT=15.0

# RAG Setup:
#   1. Knowledge base must be in leibniz_knowledge_base/ directory with 12 category subdirectories
#   2. Vector store auto-builds on first query (takes ~30s for 63 docs)
#   3. Context-aware mode: Pass context dict from intent parser for best results
#   4. Fallback mode: Pass raw query string if context unavailable
#   5. Tune similarity_threshold based on your accuracy requirements
# Recommendation: Use context-aware mode with intent parser for 20-30% better accuracy

# ============================================================================
# OpenAI Configuration (Optional - LLM fallback only, NOT used for STT)
# ============================================================================
# Note: OpenAI Whisper is NOT used in this system. Gemini Live API handles STT.
# Uncomment these only if using OpenAI as fallback LLM provider.
# OPENAI_API_KEY=your_openai_api_key_here
# Optional
# OPENAI_ORG_ID=your_org_id_here

# ============================================================================
# STT (Speech-to-Text) Configuration
# ============================================================================
# Enforce English-only transcription
LEIBNIZ_STT_STRICT_MODE=true
# File transcription timeout in seconds
LEIBNIZ_STT_TIMEOUT=30.0
# Streaming capture start timeout (no speech detected)
# INCREASED from 10.0 to 15.0 for better speech detection (gives user more time to start speaking)
LEIBNIZ_STT_STREAMING_TIMEOUT=15.0
# Silence detection timeout (speech ended)
# INCREASED from 2.5 to 3.5 to allow natural pauses in speech
LEIBNIZ_STT_SILENCE_TIMEOUT=3.5
# Minimum speech duration in milliseconds (filters out background noise)
# INCREASED from 200 to 300 to reduce false positives from clicks/noise
LEIBNIZ_STT_MIN_SPEECH_MS=300

# Audio Sample Rate for STT (CRITICAL for Realtek and modern microphones)
# ============================================================================
# IMPORTANT: Must match your microphone's supported sample rate to avoid "Invalid sample rate" errors
# 
# Common sample rates:
#   - 48000 Hz (48 kHz): For modern PC microphones (Realtek recommended)
#   - 44100 Hz (44.1 kHz): RECOMMENDED for better speech recognition compatibility
#   - 16000 Hz (16 kHz): Telephony quality (may not be supported by all hardware)
#
# To check your microphone's supported sample rates, run:
#   python -c "import sounddevice as sd; print(sd.query_devices())"
#
# Windows Realtek HD Audio users: Try 44100 Hz for better compatibility with speech recognition
# USB microphones: Check device specifications (usually 48000 or 44100)
#
# Error "Invalid sample rate [PaErrorCode -9997]" means your device doesn't support the configured rate.
# CHANGED from 48000 to 44100 for better speech recognition compatibility
LEIBNIZ_STT_SAMPLE_RATE=44100

# Audio Input Device Selection (IMPORTANT for troubleshooting "no speech detected")
# Run: python -c "import sounddevice as sd; print(sd.query_devices())" to list devices
# Options: "default" (system default), device index (e.g., 1), or device name (string)
# Windows users: If default microphone fails, explicitly set the index of your working mic
# AUDIO_INPUT_DEVICE=default

# ============================================================================
# TTS (Text-to-Speech) Configuration - Dual Provider Support
# ============================================================================
# The system supports both Google Cloud TTS and ElevenLabs with automatic fallback

# Google Cloud TTS Settings
# Path to Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# Google TTS voice (Neural2-F: female, Neural2-C: female, Neural2-A: male)
GOOGLE_TTS_VOICE=en-US-Neural2-F
# Google Cloud project ID (optional)
GOOGLE_TTS_PROJECT_ID=your_project_id

# ElevenLabs Settings
# ElevenLabs API key for TTS (get from https://elevenlabs.io)
# IMPORTANT: Replace 'your_elevenlabs_api_key_here' with your actual API key
ELEVENLABS_API_KEY=sk_3fcb6ca802b72cdd213c2f2a56d6dfd416d3bfe302dc6b0b
# ElevenLabs voice ID (NOT the voice name!)
# Get voice IDs by calling: GET https://api.elevenlabs.io/v2/voices
# Or visit: https://elevenlabs.io/app/voice-lab to see your voices
# Common premade voice IDs:
#   21m00Tcm4TlvDq8ikWAM - Rachel (calm, female)
#   EXAVITQu4vr4xnSDxMaL - Sarah (soft, female)  
#   ErXwobaYiN019PkySvjV - Antoni (well-rounded, male)
#   VR6AewLTigWG4xSOukaG - Arnold (crisp, male)
# NOTE: Use the voice_id hash, NOT the name (e.g., "EXAVITQu4vr4xnSDxMaL" not "Sarah")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Leibniz model (eleven_multilingual_v2, eleven_monolingual_v1)
ELEVENLABS_MODEL=eleven_multilingual_v2

# LemonFox TTS Settings
# LemonFox API key for TTS (get from https://www.lemonfox.ai/apis/keys)
# IMPORTANT: Replace 'your_lemonfox_api_key_here' with your actual API key
LEMONFOX_API_KEY=6KtIDvYHZAlfKcBpjwqlb1g1XdUksVM2
# LemonFox voice (sarah, heart, bella, michael, alloy, nova, echo, onyx)
LEMONFOX_VOICE=sarah
# LemonFox language (en-us, de-de, es-es, fr-fr, it-it, pl-pl, pt-br, nl-nl)
LEMONFOX_LANGUAGE=en-us

# Idle filler phrases (Comment 1: Disabled to avoid contradicting acknowledgement removal)
# Set to "false" to disable idle filler phrases like "Just a moment..."
LEIBNIZ_ENABLE_IDLE_FILLER=false

# TTS Configuration
# Primary provider: xtts_local (voice cloning), elevenlabs (premium quality), google (stable), gemini (preview), lemonfox (premium)
# TEMPORARY: Using lemonfox as primary to enable fallback until XTTS CUDA issue is resolved
LEIBNIZ_TTS_PROVIDER=lemonfox
# Fallback TTS provider if primary fails (google, elevenlabs, or gemini)
# Set to empty to disable fallback - use only LemonFox
LEIBNIZ_TTS_FALLBACK_PROVIDER=

# XTTS Local TTS Configuration (Voice Cloning)
# ---------------------------------------------
# XTTS_SPEAKER_SAMPLE: Path to 6-60 second WAV file of target voice (mono, 16-22kHz recommended)
# XTTS_LANGUAGE: Language code (en, es, fr, de, it, pt, pl, tr, ru, nl, cs, ar, zh-cn, ja, hu, ko, hi)
# XTTS_DEVICE: cuda (GPU, recommended), cpu (slower), or auto (detect)
LEIBNIZ_XTTS_SPEAKER_SAMPLE=leibniz_agent/audio/speaker_sample.wav
LEIBNIZ_XTTS_LANGUAGE=en
LEIBNIZ_XTTS_DEVICE=cuda  # or cpu, auto

# Google Cloud TTS (Recommended - Production Stable)
# Set path to your service account JSON key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ElevenLabs TTS (Premium Alternative)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Gemini TTS (Preview - Known Issues)
# WARNING: gemini-2.5-flash-preview-tts experiences frequent 500 errors
# Only use if you want to test preview features
# GEMINI_API_KEY=your_gemini_api_key_here

# Cache directory for TTS audio files
LEIBNIZ_TTS_CACHE_DIR=./leibniz_agent/tts_cache
# Enable TTS caching (true/false)
LEIBNIZ_TTS_CACHE_ENABLED=true
# Maximum number of cached entries
LEIBNIZ_TTS_CACHE_MAX_SIZE=500
# TTS synthesis timeout in seconds
LEIBNIZ_TTS_TIMEOUT=30.0
# TTS audio sample rate (24000 recommended for quality)
LEIBNIZ_TTS_SAMPLE_RATE=48000

# Gemini Live TTS Configuration
# WARNING: Use only valid Gemini TTS model names to avoid 404 NOT_FOUND errors
# Valid TTS models (CONFIRMED WORKING as of 2025):
#   - gemini-2.5-flash-preview-tts (RECOMMENDED - fast, stable, fewer 500 errors)
#   - gemini-2.5-pro-preview-tts (higher quality, slower, MORE PRONE to 500 INTERNAL errors)
# 
# NOTE: Pro/Preview models can experience "500 INTERNAL" server-side errors during high demand
#       or server overload. These are NOT fixable through code/config changes. Solutions:
#       1. Use flash model (more stable, recommended)
#       2. Wait and retry later (transient outages)
#       3. Enable fallback provider (LEIBNIZ_TTS_FALLBACK_PROVIDER=google)
#       4. Switch to Google TTS or ElevenLabs temporarily
#
# Note: gemini-live-2.5-flash-preview is for LIVE API (bidirectional VAD), NOT REST API TTS
# Note: Native audio models (gemini-2.5-flash-native-audio-preview-09-2025) are NOT available in v1beta API
# See: https://ai.google.dev/gemini-api/docs/text-to-speech
LEIBNIZ_TTS_GEMINI_MODEL=gemini-2.5-flash-preview-tts

# Valid Gemini TTS Voice Names (2025):
# Only use these voice names - others will be rejected with invalid argument error
#   Friendly/Bright: zephyr, pulcherrima, aoede, autonoe
#   Calm/Smooth: vindemiatrix, callirrhoe, leda, umbriel
#   Energetic: fenrir, puck, rasalgethi, sulafat
#   Professional: achernar, algenib, schedar, charon
# Full list: https://ai.google.dev/gemini-api/docs/speech-generation
LEIBNIZ_TTS_GEMINI_VOICE=pulcherrima

# Enable emotion-aware dialogue for Gemini (true/false)
LEIBNIZ_TTS_GEMINI_EMOTION_SUPPORT=true

# Google Cloud TTS Setup:
#   1. Create a Google Cloud project
#   2. Enable Cloud Text-to-Speech API
#   3. Create a service account and download JSON key
#   4. Set GOOGLE_APPLICATION_CREDENTIALS to the key file path
#
# ElevenLabs Setup:
#   1. Sign up at https://elevenlabs.io
#   2. Get API key from profile settings
#   3. Choose a voice from the voice library
#
# Gemini Live TTS Setup:
#   1. Get Gemini API key from https://aistudio.google.com/apikey
#   2. Set GEMINI_API_KEY above (already configured for STT)
#   3. Install google-genai: pip install google-genai>=1.33.0
#   4. Choose model (native audio recommended for emotion-aware speech)
#
# Provider Recommendations:
#   - gemini: Most natural speech with emotion-aware dialogue (RECOMMENDED)
#   - auto: Automatic fallback across all three providers (best reliability)
#   - google: Precise prosody control with SSML support
#   - elevenlabs: Excellent voice quality with streaming support
#
# Cost Considerations:
#   - Gemini: Pay-per-character (~$0.04 per 1M characters for audio output)
#   - Google: Pay-per-character (~$4 per 1M characters for Neural2 voices)
#   - ElevenLabs: Subscription-based ($5-$99/month depending on usage)

# Get Google Cloud credentials: https://cloud.google.com/text-to-speech/docs/setup
# Get ElevenLabs API key: https://elevenlabs.io
# Get Gemini API key: https://aistudio.google.com/apikey

# ============================================================================
# MongoDB Configuration (Conversation history, user memory, appointments)
# ============================================================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/

# Or MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

MONGODB_DATABASE=leibniz_agent
MONGODB_COLLECTION_CONVERSATIONS=conversations
MONGODB_COLLECTION_APPOINTMENTS=appointments
MONGODB_COLLECTION_USER_MEMORY=user_memory

# Get MongoDB Atlas: https://www.mongodb.com/cloud/atlas

# ============================================================================
# Redis Configuration (Microservices Infrastructure)
# ============================================================================
# Redis is used for caching, session state, and inter-service communication
# in the Leibniz microservices architecture.

# Redis connection settings
LEIBNIZ_REDIS_HOST=localhost
LEIBNIZ_REDIS_PORT=6379
LEIBNIZ_REDIS_DB=0
# Redis password (optional, leave empty for local dev)
LEIBNIZ_REDIS_PASSWORD=

# Connection pool settings
LEIBNIZ_REDIS_MAX_CONNECTIONS=50
LEIBNIZ_REDIS_SOCKET_TIMEOUT=5.0
LEIBNIZ_REDIS_SOCKET_CONNECT_TIMEOUT=5.0

# Redis URL (alternative to individual settings)
# Format: redis://[:password@]host:port/db
# Example: redis://localhost:6379/0
# For Docker: redis://redis:6379/0
LEIBNIZ_REDIS_URL=redis://localhost:6379/0

# Cache TTL settings (seconds)
LEIBNIZ_REDIS_INTENT_CACHE_TTL=1800  # 30 minutes
LEIBNIZ_REDIS_RAG_CACHE_TTL=3600     # 1 hour
LEIBNIZ_REDIS_SESSION_TTL=1800       # 30 minutes

# Redis Setup:
#   1. For local development: Use docker-compose.leibniz.yml
#      docker-compose -f docker-compose.leibniz.yml up -d redis
#   2. For Docker services: Set LEIBNIZ_REDIS_HOST=redis (service name)
#   3. For production: Set LEIBNIZ_REDIS_PASSWORD and use managed Redis
#   4. Test connection: python -m leibniz_agent.services.shared.health_check --redis
#
# Recommendation: Use default settings for local dev, configure for production

# ============================================================================
# Knowledge Base Configuration
# ============================================================================
LEIBNIZ_KNOWLEDGE_BASE_PATH=c:/Users/AMAR/SINDHv2/SINDH-Orchestra-Complete/leibniz_knowledge_base
VECTOR_STORE_PATH=./leibniz_agent/vector_store
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Number of documents to retrieve
RAG_TOP_K=8

# ============================================================================
# Agent Configuration
# ============================================================================
# Optional custom config
LEIBNIZ_CONFIG_FILE=./leibniz_agent/leibniz_config.json
LEIBNIZ_AGENT_NAME=Lexi
LEIBNIZ_LANGUAGE=en-US
LEIBNIZ_RESPONSE_STYLE=friendly_casual

# ============================================================================
# Audio Settings
# ============================================================================
# Audio Input Device (for STT)
# Run: python -c "import sounddevice as sd; print(sd.query_devices())"
# Then set to the index of your working microphone
# AUDIO_INPUT_DEVICE=1

# Microphone Device Selection (IMPORTANT for avoiding "no speech detected")
# ============================================================================
# To list available devices, run:
#   python -c "import sounddevice; print(sounddevice.query_devices())"
#
# Options:
#   - "default" or empty: Use system default microphone
#   - Device index (integer): 0, 1, 2, etc. (from device list)
#   - Device name (string): "Microphone (Realtek High Definition Audio)"
#
# Common issues:
#   - If VAD shows "no speech detected" repeatedly, your default device may be wrong
#   - Virtual audio devices (OBS, Discord) often become default and capture silence
#   - USB microphones may have different indices than built-in mics
#
# CHANGED from 'default' to device 3 (Microphone Array - Realtek)
# This is based on the device list where [3] is "Microphone Array (Realtek(R) Au"
# If speech detection still fails, try devices 4, 5, or run the device list command
# NOTE: Device 1 appears to be the working Microphone Array based on test results
AUDIO_INPUT_DEVICE=1
AUDIO_OUTPUT_DEVICE=default
# Audio sample rate (UPDATED to match LEIBNIZ_STT_SAMPLE_RATE - use 44100 for better compatibility)
AUDIO_SAMPLE_RATE=44100
# CRITICAL FIX: Changed from 1 to 2 - Realtek devices require stereo (2 channels)
# Error "Invalid number of channels [PaErrorCode -9998]" occurs when using 1 channel
AUDIO_CHANNELS=2

# ============================================================================
# VAD (Voice Activity Detection) Configuration
# ============================================================================
# These settings control how sensitive the VAD is to detecting speech
# IMPORTANT: Adjust these if you're experiencing "no speech detected" issues

# VAD sensitivity level: LOW, MEDIUM, HIGH
# HIGH = more aggressive speech detection (recommended for quiet microphones or noisy environments)
# MEDIUM = balanced detection (default)
# LOW = less sensitive (use if getting false positives from background noise)
LEIBNIZ_VAD_SENSITIVITY=HIGH

# VAD silence timeout (seconds) - how long to wait for silence before ending capture
# INCREASED from 2.0 to 3.5 to allow natural pauses in speech
LEIBNIZ_VAD_SILENCE_TIMEOUT=3.5

# VAD ignore Gemini's turn_complete signal (use silence-based detection instead)
# true = More accurate transcription (ignores premature turn_complete signals)
# false = Faster response but may cut off mid-sentence
LEIBNIZ_VAD_IGNORE_TURN_COMPLETE=true

# VAD start timeout (seconds) - how long to wait for speech to begin
# INCREASED from 10.0 to 15.0 to give user more time to start speaking
LEIBNIZ_VAD_START_TIMEOUT=15.0

# VAD minimum speech duration (milliseconds) - filters out background noise
# INCREASED from 200 to 300 to reduce false positives from clicks/pops
LEIBNIZ_VAD_MIN_SPEECH_MS=300

# ============================================================================
# Performance Settings (timeouts in seconds)
# ============================================================================
RESPONSE_TIMEOUT=10.0
STT_TIMEOUT=5.0
TTS_TIMEOUT=5.0
RAG_TIMEOUT=3.0
INTENT_TIMEOUT=2.0

# ============================================================================
# Continuous VAD Configuration (Background Listening Mode)
# ============================================================================
# Enable continuous background listening for real-time barge-in support.
# When enabled, VAD runs continuously in background instead of per-turn.
#
# Benefits:
#   - <100ms latency per turn (vs 1-2s per-turn mode)
#   - Real-time barge-in during agent TTS playback
#   - Natural conversation flow without waiting for agent to finish
#
# Trade-offs:
#   - More complex (background tasks, event coordination)
#   - Slightly higher CPU usage (continuous audio streaming)
#   - Requires stable microphone connection

# Enable continuous background VAD (default: false for backward compatibility)
LEIBNIZ_ENABLE_CONTINUOUS_VAD=true

# Continuous VAD behavior settings
LEIBNIZ_CONTINUOUS_VAD_TIMEOUT=30.0  # Max wait time for user speech (seconds)
LEIBNIZ_CONTINUOUS_VAD_BARGE_IN_ENABLED=true  # Allow interrupting agent during TTS
LEIBNIZ_CONTINUOUS_VAD_AUTO_RESTART=true  # Auto-restart listener on errors

# Audio streaming settings (continuous mode)
LEIBNIZ_CONTINUOUS_VAD_AUDIO_QUEUE_SIZE=100  # Audio chunk queue size
LEIBNIZ_CONTINUOUS_VAD_CHUNK_SIZE=800  # Samples per chunk (50ms at 16kHz)

# Setup:
#   1. Set LEIBNIZ_ENABLE_CONTINUOUS_VAD=true to enable
#   2. Restart Leibniz Pro: python -m leibniz_agent.leibniz_pro
#   3. Verify logs show "✅ Continuous VAD started"
#   4. Test barge-in: interrupt agent mid-sentence
#
# Troubleshooting:
#   - If barge-in not working: Check LEIBNIZ_CONTINUOUS_VAD_BARGE_IN_ENABLED=true
#   - If high latency: Verify continuous mode is actually enabled (check logs)
# Recommendation: Enable for production after testing in development

# ============================================================================
# Dialogue Management Configuration
# ============================================================================
# Pre-defined dialogues for common interactions (non-RAG responses)
# Format: LEIBNIZ_DIALOGUE_<CATEGORY>_<KEY>=text
# These dialogues will be synthesized once and cached in audio archive

# Enable dialogue archive system (true/false)
LEIBNIZ_ENABLE_DIALOGUE_ARCHIVE=false

# Dialogue archive directory (relative to leibniz_agent/)
LEIBNIZ_DIALOGUE_ARCHIVE_DIR=leibniz_agent/audio/dialogues

# Auto-generate missing dialogue audio on first use (true/false)
LEIBNIZ_DIALOGUE_AUTO_GENERATE=true

# Greetings category
LEIBNIZ_DIALOGUE_GREETINGS_INTRO="Hello! I'm TARA, the receptionist at Leibniz University. Welcome! How may I assist you today?"
LEIBNIZ_DIALOGUE_GREETINGS_WELCOME="Hello! How can I help you?"
LEIBNIZ_DIALOGUE_GREETINGS_HELP="Hello! I'm here to help you with information about Leibniz University. What can I assist you with today?"

# Farewells category
LEIBNIZ_DIALOGUE_FAREWELLS_OUTRO="Thanks for chatting! Have a great day, and feel free to reach out anytime you need help."
LEIBNIZ_DIALOGUE_FAREWELLS_EXIT="Goodbye! Have a wonderful day."

# Prompts category
LEIBNIZ_DIALOGUE_PROMPTS_HELP="How can I help you today?"
LEIBNIZ_DIALOGUE_PROMPTS_CONTINUE="Is there anything else I can help you with?"
LEIBNIZ_DIALOGUE_PROMPTS_CLARIFY="I didn't quite catch that. Could you rephrase your question?"

# Errors category
LEIBNIZ_DIALOGUE_ERRORS_GENERAL="I'm sorry, I encountered an issue. Could you try again?"
LEIBNIZ_DIALOGUE_ERRORS_TIMEOUT="I didn't catch that. Could you please repeat?"
LEIBNIZ_DIALOGUE_ERRORS_NO_INPUT="I haven't been able to hear you clearly. Could you try speaking again?"
LEIBNIZ_DIALOGUE_ERRORS_NO_INPUT_MAX="I haven't been able to hear you for several attempts. There might be an issue with your microphone or audio settings."
LEIBNIZ_DIALOGUE_ERRORS_TECHNICAL="There seems to be a technical issue. Please try again in a moment."

# Appointments category
LEIBNIZ_DIALOGUE_APPOINTMENTS_CONFIRM="Great! Your appointment is all set. You'll receive a confirmation email soon."
LEIBNIZ_DIALOGUE_APPOINTMENTS_CANCEL="Your appointment has been cancelled. Let me know if you'd like to schedule a different time."

# Thinking category
LEIBNIZ_DIALOGUE_THINKING_INDICATOR="Let me check that for you..."

# ============================================================================
# Dialogue Management Configuration
# ============================================================================
# Pre-defined dialogues for common interactions (non-RAG responses)
# Format: LEIBNIZ_DIALOGUE_<CATEGORY>_<KEY>=text
# These dialogues will be synthesized once and cached in audio archive

# Enable dialogue archive system (true/false)
LEIBNIZ_ENABLE_DIALOGUE_ARCHIVE=true

# Dialogue archive directory (relative to leibniz_agent/)
LEIBNIZ_DIALOGUE_ARCHIVE_DIR=leibniz_agent/audio/dialogues

# Auto-generate missing dialogue audio on first use (true/false)
LEIBNIZ_DIALOGUE_AUTO_GENERATE=true

# Greetings category
LEIBNIZ_DIALOGUE_GREETINGS_INTRO="Hello! I'm the receptionist at Leibniz University. Welcome! How may I assist you today?"
LEIBNIZ_DIALOGUE_GREETINGS_WELCOME="Hello! How can I help you?"
LEIBNIZ_DIALOGUE_GREETINGS_HELP="Hello! I'm here to help with information about Leibniz University. What can I assist you with?"

# Farewells category
LEIBNIZ_DIALOGUE_FAREWELLS_OUTRO="Thanks for chatting! Have a great day, and feel free to reach out anytime you need help."
LEIBNIZ_DIALOGUE_FAREWELLS_EXIT="Goodbye! Have a wonderful day."

# Prompts category
LEIBNIZ_DIALOGUE_PROMPTS_HELP="How can I help you today?"
LEIBNIZ_DIALOGUE_PROMPTS_CONTINUE="Is there anything else I can help you with?"
LEIBNIZ_DIALOGUE_PROMPTS_CLARIFY="I didn't quite catch that. Could you rephrase your question?"

# Errors category
LEIBNIZ_DIALOGUE_ERRORS_GENERAL="I'm sorry, I encountered an issue. Could you try again?"
LEIBNIZ_DIALOGUE_ERRORS_TIMEOUT="I didn't catch that. Could you please repeat?"
LEIBNIZ_DIALOGUE_ERRORS_NO_INPUT="I haven't been able to hear you clearly. Could you try speaking a bit louder or closer to the microphone?"
LEIBNIZ_DIALOGUE_ERRORS_NO_INPUT_MAX="I've tried several times but still can't hear you clearly. There might be an issue with your microphone or audio setup."
LEIBNIZ_DIALOGUE_ERRORS_TECHNICAL="There seems to be a technical issue with the audio system. Please try again in a moment."

# Appointments category
LEIBNIZ_DIALOGUE_APPOINTMENTS_CONFIRM="Great! Your appointment is all set. You'll receive a confirmation email soon."
LEIBNIZ_DIALOGUE_APPOINTMENTS_CANCEL="Your appointment has been cancelled successfully."
LEIBNIZ_DIALOGUE_APPOINTMENTS_DATE_PROMPT="What date would you like to schedule your appointment?"
LEIBNIZ_DIALOGUE_APPOINTMENTS_TIME_PROMPT="What time works best for you?"
LEIBNIZ_DIALOGUE_APPOINTMENTS_EMAIL_PROMPT="Can you provide your email address for the appointment confirmation?"

# Thinking category
LEIBNIZ_DIALOGUE_THINKING_INDICATOR="Let me check that for you."

# ============================================================================
# Persistent Services Configuration (Async Queue-Based Processing)
# ============================================================================
# These settings control the behavior of leibniz_persistent_services.py
# for production-grade low-latency, high-throughput processing.

# Queue Size Configuration
# ------------------------
# Intent classification queue size (max concurrent requests)
LEIBNIZ_INTENT_QUEUE_SIZE=100
# RAG query queue size (max concurrent requests)
LEIBNIZ_RAG_QUEUE_SIZE=50

# Cache Configuration
# ------------------
# Recent results cache TTL (Time-To-Live) in seconds
# This controls how long completed results are cached for deduplication
LEIBNIZ_CACHE_TTL_SECONDS=10
# In-flight request freshness check TTL (deduplication window)
LEIBNIZ_RECENT_RESULTS_TTL=5

# Pre-warming Configuration
# -------------------------
# Enable pre-warming during TTS playback (highly recommended)
# Pre-warming reduces latency by 200-500ms for next query
LEIBNIZ_ENABLE_PREWARM=true
# Pre-warming delay in seconds (start N seconds before TTS audio ends)
# Recommended: 2.0 seconds to ensure models ready when user finishes listening
LEIBNIZ_PREWARM_DELAY=2.0
# Speech detection pre-warming throttle (minimum seconds between pre-warms)
# Prevents excessive pre-warming when user speaks repeatedly
LEIBNIZ_PREWARM_THROTTLE_SECONDS=5.0

# Performance Monitoring
# ---------------------
# Log queue depth when > 0 (helpful for monitoring overload)
LEIBNIZ_LOG_QUEUE_DEPTH=true
# Print performance stats every N interactions (0 = disabled)
LEIBNIZ_PERFORMANCE_STATS_INTERVAL=10

# Persistent Services Performance Characteristics:
# ------------------------------------------------
# Request submission: <1ms (non-blocking queue insertion)
# Intent classification: 500-1500ms (cold), 200-800ms (warm)
# RAG query: 800-2000ms (cold), 400-1200ms (warm)
# Cache retrieval: <10ms (in-memory lookup)
# Request deduplication: 0ms (reuses existing result)
# Pre-warming: <10ms (lightweight), ~500ms (inference)
#
# Expected Cache Hit Rates:
# - Intent classification: 40-60% typical
# - RAG queries: 30-50% typical
#
# Expected Deduplication Rate:
# - 15-20% reduction in redundant work
#
# Pre-warming Latency Reduction:
# - 200-500ms improvement on first call after pre-warming

# Persistent Services Setup:
#   1. No special setup required - uses existing Gemini API key
#   2. Services auto-initialize on first use
#   3. Vector store auto-builds from knowledge base on first RAG query
#   4. Queues use asyncio for non-blocking processing
#   5. Pre-warming triggers during TTS playback automatically
#
# Recommendations:
#   - Keep LEIBNIZ_ENABLE_PREWARM=true for best user experience
#   - Use default queue sizes (100/50) unless handling high traffic
#   - Monitor LEIBNIZ_PERFORMANCE_STATS_INTERVAL to track efficiency
#   - Increase LEIBNIZ_PREWARM_DELAY if TTS audio is very short
#
# Integration with Main Orchestrator:
#   - Import: from leibniz_agent import get_leibniz_services_manager
#   - Initialize: manager = await get_leibniz_services_manager()
#   - Intent: await manager.fast_classify_intent(user_text)
#   - RAG: await manager.process_rag_query(user_text, context={...})
#   - Pre-warm: await manager.prewarm_during_tts_audio(audio_duration)
#   - Monitor: status = manager.get_service_status()

# ============================================================================
# Appointment Booking FSM Configuration
# ============================================================================
# Finite state machine for collecting appointment booking information
# Controls validation rules, retry behavior, and booking system integration

# FSM Behavior Configuration
# --------------------------
# Maximum retries per field before offering to skip
LEIBNIZ_APPOINTMENT_MAX_RETRIES=3
# Allow skipping fields after max retries (recommended for better UX)
LEIBNIZ_APPOINTMENT_ENABLE_SKIP=true
# Whether student ID is required (false = optional)
LEIBNIZ_APPOINTMENT_REQUIRE_STUDENT_ID=false

# Multilingual Support (Semantic Translation)
# -------------------------------------------
# Enable multilingual input with automatic translation to English for FSM
# Supports Hindi, Telugu, Tamil, Kannada, Malayalam, and mixed languages
# Uses Gemini API to translate and extract semantic context for slot filling
LEIBNIZ_APPOINTMENT_ENABLE_MULTILINGUAL=true
# Translation timeout in seconds
LEIBNIZ_SEMANTIC_TRANSLATOR_TIMEOUT=5.0

# Validation Configuration
# -----------------------
# Require university email (@uni-hannover.de) or accept any valid email
# Set to true to enforce university email (recommended for students)
LEIBNIZ_APPOINTMENT_STRICT_EMAIL=false
# Require country code in phone number (recommended for international support)
LEIBNIZ_APPOINTMENT_REQUIRE_COUNTRY_CODE=true
# Default country code for German numbers (without country code)
LEIBNIZ_APPOINTMENT_DEFAULT_COUNTRY_CODE=+49
# Maximum months in advance for booking (reasonable booking window)
LEIBNIZ_APPOINTMENT_MAX_BOOKING_MONTHS=3

# Date/Time Configuration
# ----------------------
# Business hours start time (HH:MM format)
LEIBNIZ_APPOINTMENT_BUSINESS_HOURS_START=08:00
# Business hours end time (HH:MM format)
LEIBNIZ_APPOINTMENT_BUSINESS_HOURS_END=18:00
# Default time for "morning" requests (HH:MM format)
LEIBNIZ_APPOINTMENT_DEFAULT_MORNING_TIME=10:00
# Default time for "afternoon" requests (HH:MM format)
LEIBNIZ_APPOINTMENT_DEFAULT_AFTERNOON_TIME=14:00

# Booking System Integration (Future)
# -----------------------------------
# University booking system API endpoint (future integration)
LEIBNIZ_BOOKING_API_URL=https://termine.uni-hannover.de/api
# API key for booking system (future integration)
LEIBNIZ_BOOKING_API_KEY=your_api_key_here
# Send confirmation email after booking
LEIBNIZ_BOOKING_CONFIRMATION_EMAIL=true
LEIBNIZ_ENABLE_BACKGROUND_AUDIO=true
LEIBNIZ_BACKGROUND_AUDIO_PATH=leibniz_agent/audio/background.wav
LEIBNIZ_BACKGROUND_AUDIO_VOLUME=0.9
# Appointment FSM Setup:
#   1. Adjust max_retries based on user patience (3 is balanced)
#   2. Set strict_email=true to require university email (recommended for students)
#   3. Configure business hours to match university schedule
#   4. Set default times for natural language requests ('morning', 'afternoon')
#   5. Booking API integration requires university system credentials (future)
#
# Recommendation: Use default settings for balanced user experience
#
# Integration with Main Orchestrator:
#   - Import: from leibniz_agent import create_appointment_fsm
#   - Create FSM: fsm = create_appointment_fsm()
#   - Process input: result = await fsm.process_input(user_text)
#   - Check completion: if result['complete']: booking_data = fsm.data.to_dict()
#   - Format for submission: booking_data = format_appointment_for_submission(fsm.data)

# ============================================================================
# Logging Configuration
# ============================================================================
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=./logs/leibniz_agent.log
LOG_CONVERSATIONS=true

# ============================================================================
# Main Orchestration Configuration
# ============================================================================
# Configuration for leibniz_pro.py main conversation loop

# Conversation Flow Configuration
# -------------------------------
# Play intro audio file or speak greeting
LEIBNIZ_ENABLE_INTRO_AUDIO=true
# Path to intro audio file (optional)
LEIBNIZ_INTRO_AUDIO_PATH=./leibniz_agent/audio/intro.wav
# Enable ambient background audio (optional)
LEIBNIZ_ENABLE_BACKGROUND_AUDIO=true
# Path to background audio file
LEIBNIZ_BACKGROUND_AUDIO_PATH=./leibniz_agent/audio/background.wav
# Background audio volume (0.0-1.0)
LEIBNIZ_BACKGROUND_AUDIO_VOLUME=0.9
# Background audio ducking factor during TTS (0.0-1.0, lower = more ducking)
LEIBNIZ_BACKGROUND_DUCKING_FACTOR=1.0

# Barge-In Configuration
# ----------------------
# Enable barge-in detection during TTS playback
LEIBNIZ_ENABLE_BARGE_IN=true
# Barge-in sensitivity (LOW, MEDIUM, HIGH)
LEIBNIZ_BARGE_IN_SENSITIVITY=MEDIUM

# Streaming TTS Configuration
# ----------------------------
# Enable sentence-level streaming TTS
LEIBNIZ_ENABLE_STREAMING_TTS=true
# Minimum sentence length for streaming (characters)
LEIBNIZ_MIN_SENTENCE_LENGTH=10
# Number of sentences to buffer before playback
LEIBNIZ_SENTENCE_BUFFER_SIZE=3

# Pre-Warming Configuration
# --------------------------
# Enable pre-warming during TTS playback
LEIBNIZ_ENABLE_PREWARM_DURING_TTS=true
# Start pre-warming N seconds before TTS ends
LEIBNIZ_PREWARM_DELAY_SECONDS=2.0
# Enable full inference pre-warming during initialization
LEIBNIZ_ENABLE_INFERENCE_PREWARM=true

# Session Configuration
# ----------------------
# Maximum session duration in seconds (10 minutes)
LEIBNIZ_MAX_SESSION_DURATION=600
# Session timeout after inactivity (seconds)
LEIBNIZ_SESSION_TIMEOUT=30
# Enable multiple consecutive sessions
LEIBNIZ_ENABLE_MULTI_SESSION=true

# Logging Configuration
# ----------------------
# Log full conversation transcripts
LEIBNIZ_LOG_CONVERSATION=true
# Log performance metrics after each session
LEIBNIZ_LOG_PERFORMANCE_METRICS=true
# Log barge-in detection events
LEIBNIZ_LOG_BARGE_IN_EVENTS=true

# Main Orchestration Setup:
#   1. Enable intro audio for professional greeting (optional)
#   2. Enable barge-in for natural conversation flow (recommended)
#   3. Enable streaming TTS for progressive response playback (recommended)
#   4. Enable pre-warming during TTS for reduced latency (recommended)
#   5. Configure session timeout based on expected conversation length
# Recommendation: Use default settings for balanced user experience

# ============================================================================
# Development/Testing Settings
# ============================================================================
# development, staging, production
ENVIRONMENT=development
DEBUG_MODE=false
# For testing without microphone
MOCK_STT=false
# For testing without audio output
MOCK_TTS=false

# ============================================================================
# Security Settings
# ============================================================================
ENABLE_ENCRYPTION=true
ANONYMIZE_LOGS=true
DATA_RETENTION_DAYS=30

# ============================================================================
# Cost Estimates (as of 2025)
# ============================================================================
# OpenAI Whisper: ~$0.006 per minute of audio
# ElevenLabs: ~$0.30 per 1,000 characters (varies by plan)
# Google TTS: ~$4.00 per 1 million characters
# Gemini: Free tier available, paid plans vary
# MongoDB Atlas: Free tier (512MB), paid plans start at $9/month

# ============================================================================
# Required vs Optional Services
# ============================================================================
# REQUIRED:
#   - OpenAI API key (for Whisper STT)
#   - ElevenLabs OR Google TTS (for speech synthesis)
#   - Gemini API key (for LLM and intent parsing)
#
# OPTIONAL:
#   - MongoDB (can use local file storage for development)
#
# ============================================================================
# Security Reminder
# ============================================================================
# 🔒 NEVER commit this file with real API keys to version control
# 🔒 Add .env to your .gitignore file

# ============================================================================
# Troubleshooting
# ============================================================================
# - STT "No speech detected": Set AUDIO_INPUT_DEVICE to correct microphone index
# - TTS 500 errors: Switch LEIBNIZ_TTS_PROVIDER from gemini to google
# - Import errors: Run tests with: python -m leibniz_agent.test_stt
# - ModuleNotFoundError: Ensure you're running from parent directory (SINDH-Orchestra-Complete)
# - "No providers available": Check that at least one TTS API key is configured
# 🔒 Rotate API keys regularly
# 🔒 Use environment-specific .env files (.env.development, .env.production)
# 🔒 Consider using a secrets manager in production (AWS Secrets Manager, Azure Key Vault, etc.)

# ============================================================================
# TTS Microservice Configuration (Phase 5)
# ============================================================================
# Standalone TTS service for production deployment with Docker.
# This service provides RESTful HTTP endpoints for text-to-speech synthesis
# with multi-provider support, caching, and fallback logic.

# Service Port
# ------------
# Port for TTS microservice HTTP server
LEIBNIZ_TTS_SERVICE_PORT=8004

# Provider Selection
# -----------------
# Primary TTS provider (google, elevenlabs, gemini, xtts_local, mock)
# NOTE: Variables LEIBNIZ_TTS_PROVIDER and LEIBNIZ_TTS_FALLBACK_PROVIDER above
# are already defined for the main leibniz_pro agent. The microservice will
# read from those same variables.

# Cache Settings
# -------------
# Enable TTS audio caching (highly recommended for production)
LEIBNIZ_TTS_CACHE_ENABLED=true
# Cache directory (absolute path or relative to service root)
LEIBNIZ_TTS_CACHE_DIR=./audio_cache
# Maximum cache size (number of entries)
LEIBNIZ_TTS_CACHE_MAX_SIZE=500
# Cache TTL in days (entries older than this are evicted)
LEIBNIZ_TTS_CACHE_TTL_DAYS=30

# Audio Settings
# -------------
# Default language code for synthesis
LEIBNIZ_TTS_LANGUAGE_CODE=en-US
# Default sample rate (Hz) - 24000 recommended for most providers
LEIBNIZ_TTS_SAMPLE_RATE=24000
# Default speaking rate multiplier (0.25-4.0, 1.0 = normal)
LEIBNIZ_TTS_SPEAKING_RATE=1.0
# Default pitch adjustment (semitones, -20.0 to 20.0)
LEIBNIZ_TTS_PITCH=0.0

# Service Behavior
# ---------------
# Request timeout in seconds
LEIBNIZ_TTS_TIMEOUT=30.0
# Retry attempts per provider
LEIBNIZ_TTS_RETRY_ATTEMPTS=3
# Retry delay in seconds (exponential backoff: 1s, 2s, 4s)
LEIBNIZ_TTS_RETRY_DELAY=1.0
# Enable fallback to secondary provider on failure
LEIBNIZ_TTS_ENABLE_FALLBACK=true

# Gemini Live TTS Settings (if provider=gemini)
# ----------------------------------------------
# Gemini model for TTS synthesis
LEIBNIZ_TTS_GEMINI_MODEL=gemini-2.0-flash-exp
# Gemini voice character (Puck, Charon, Kore, Fenrir, Aoede, Callirrhoe)
LEIBNIZ_TTS_GEMINI_VOICE=Callirrhoe
# Enable emotion-aware synthesis via system prompts
LEIBNIZ_TTS_GEMINI_EMOTION_SUPPORT=true

# TTS Microservice Endpoints:
# ---------------------------
# POST /api/v1/synthesize - Generate TTS audio
#   Body: {"text": "Hello world", "voice": "optional", "emotion": "helpful"}
#   Returns: {"cache_key": "...", "audio_url": "/api/v1/audio/...", "provider": "gemini"}
#
# GET /api/v1/audio/{cache_key} - Retrieve cached audio
#   Returns: WAV audio file (audio/wav)
#
# GET /health - Service health check
#   Returns: {"status": "healthy", "providers_available": ["gemini", "google"], "cache_stats": {...}}
#
# Docker Deployment:
#   docker-compose -f docker-compose.leibniz.yml up tts
#
# Local Development:
#   cd leibniz_agent/services/tts
#   uvicorn app:app --host 0.0.0.0 --port 8004 --workers 1
#
# Integration Example:
#   import httpx
#   response = await httpx.post("http://localhost:8004/api/v1/synthesize",
#                                json={"text": "Hello!", "emotion": "excited"})
#   audio_url = response.json()["audio_url"]
#   audio = await httpx.get(f"http://localhost:8004{audio_url}")
#
# Performance Expectations:
#   - Cache hit: <10ms
#   - Cache miss (Gemini): 500-1500ms
#   - Cache miss (Google): 300-1000ms
#   - Cache miss (ElevenLabs): 800-2000ms
#   - Fallback adds +500-1000ms latency
#
# Recommendations:
#   - Enable caching for production (LEIBNIZ_TTS_CACHE_ENABLED=true)
#   - Use gemini as primary provider for emotion support
#   - Use google as fallback for reliability
#   - Mount audio_cache volume in Docker for persistence
#   - Monitor cache hit rates via /health endpoint

# ============================================================================
# Continuous VAD Configuration (Background Listening Mode)
# ============================================================================
# Enable continuous background listening for real-time barge-in support.
# When enabled, VAD runs continuously in background instead of per-turn.
#
# Benefits:
#   - <100ms latency per turn (vs 1-2s per-turn mode)
#   - Real-time barge-in during TTS playback
#   - Natural conversation flow without waiting for agent to finish
#
# Trade-offs:
#   - More complex (background tasks, event coordination)
#   - Slightly higher CPU usage (continuous audio streaming)
#   - Requires stable microphone connection

# Enable continuous background VAD (default: false for backward compatibility)
LEIBNIZ_ENABLE_CONTINUOUS_VAD=true

# Continuous VAD behavior settings
LEIBNIZ_CONTINUOUS_VAD_TIMEOUT=30.0  # Max wait time for user speech (seconds)
LEIBNIZ_CONTINUOUS_VAD_BARGE_IN_ENABLED=true  # Allow interrupting agent during TTS
LEIBNIZ_CONTINUOUS_VAD_AUTO_RESTART=true  # Auto-restart listener on errors

# Audio streaming settings (continuous mode)
LEIBNIZ_CONTINUOUS_VAD_AUDIO_QUEUE_SIZE=100  # Audio chunk queue size
LEIBNIZ_CONTINUOUS_VAD_CHUNK_SIZE=800  # Samples per chunk (50ms at 16kHz)

# Watchdog timeout for continuous VAD (prevents stuck sessions)
LEIBNIZ_CONTINUOUS_VAD_WATCHDOG_TIMEOUT=30.0

# Setup:
#   1. Set LEIBNIZ_ENABLE_CONTINUOUS_VAD=true to enable
#   2. Restart Leibniz Pro: python -m leibniz_agent.leibniz_pro
#   3. Verify logs show "✅ Continuous VAD started"
#   4. Test barge-in: interrupt agent mid-sentence
#
# Troubleshooting:
#   - If barge-in not working: Check LEIBNIZ_CONTINUOUS_VAD_BARGE_IN_ENABLED=true
#   - If high latency: Verify continuous mode is actually enabled (check logs)
#   - If errors: Set LEIBNIZ_ENABLE_CONTINUOUS_VAD=false to use per-turn mode
#
# Recommendation: Enable for production after testing in development
